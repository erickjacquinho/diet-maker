{
  "description": "Finaliza testes automaticamente apos 90 segundos de execucao e limpa processos travados.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/enforce-test-timeout.mjs\"",
            "commandWindows": "node \".codex/hooks/enforce-test-timeout.mjs\"",
            "timeout": 15,
            "statusMessage": "Aplicando limite de 90s aos testes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/cleanup-hanging-tests.mjs\"",
            "commandWindows": "node \".codex/hooks/cleanup-hanging-tests.mjs\"",
            "timeout": 15,
            "statusMessage": "Verificando processos de teste em execucao"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/cleanup-hanging-tests.mjs\"",
            "commandWindows": "node \".codex/hooks/cleanup-hanging-tests.mjs\"",
            "timeout": 3,
            "statusMessage": "Limpando processos de teste ao encerrar sessao"
          }
        ]
      }
    ]
  }
}
