# Copy to .env.local. Fill the local Supabase values from `npx supabase status -o env`.
# Keep every value server-only; never rename these to NEXT_PUBLIC_*.
# Running the app against the local stack needs the Auth gateway: set `[api] enabled = true` in supabase/config.toml
# on your machine (the committed file keeps it off) and restart with `npx supabase stop && npx supabase start`.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# This must use the restricted app_runtime database role, not postgres/service_role.
ONLINE_DATABASE_URL=
# Required for remote Postgres: official Supabase CA certificate encoded as one-line Base64.
ONLINE_DATABASE_SSL_CA_B64=
# Keep this 32-byte base64 key in a restricted secret store and a separate recovery backup.
SERVER_MASTER_KEY=
SERVER_MASTER_KEY_ID=local-v1
# server-only; generate with `openssl rand -base64 32`; never reuse SERVER_MASTER_KEY.
ACCOUNT_KEK_ACTIVE_ID=
ACCOUNT_KEK_V1=
