{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutridiet.local/schemas/component-registry.schema.json",
  "title": "NutriDiet Component Category Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "components"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentSourceCount", "capturedAt"],
      "properties": {
        "currentSourceCount": { "type": "integer", "minimum": 0 },
        "capturedAt": { "type": "string", "format": "date" }
      }
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "layer": {
      "enum": ["ui", "atom", "molecule", "organism", "template"]
    },
    "category": {
      "enum": [
        "actions",
        "fields",
        "selection",
        "navigation",
        "surfaces",
        "data-display",
        "feedback",
        "overlays",
        "loading",
        "nutrition-domain",
        "structure"
      ]
    },
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "discoveredLayer"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^src/components/.+\\.tsx$"
        },
        "role": {
          "enum": ["implementation", "reexport", "compound-family"]
        },
        "discoveredLayer": { "$ref": "#/$defs/layer" }
      }
    },
    "publicExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "documentedBy"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["component", "compound-part", "recipe", "hook", "type"]
        },
        "documentedBy": {
          "enum": ["category", "profile", "non-visual"]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "nature",
        "lifecycle",
        "currentLayer",
        "targetLayer",
        "primaryCategory",
        "traits",
        "sourceFiles",
        "publicExports",
        "profile",
        "consumers",
        "primitiveBase",
        "specStatus",
        "exceptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "nature": {
          "enum": ["ui-generic", "product-generic", "domain"]
        },
        "lifecycle": {
          "enum": [
            "proposed",
            "experimental",
            "implemented",
            "migration-required",
            "stable",
            "deprecated",
            "removed"
          ]
        },
        "currentLayer": {
          "anyOf": [
            { "$ref": "#/$defs/layer" },
            { "type": "null" }
          ]
        },
        "targetLayer": { "$ref": "#/$defs/layer" },
        "primaryCategory": { "$ref": "#/$defs/category" },
        "traits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceFile" }
        },
        "publicExports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/publicExport" }
        },
        "profile": {
          "type": "string",
          "pattern": "^design-system/components/profiles/.+\\.md$"
        },
        "consumers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "primitiveBase": {
          "type": ["string", "null"]
        },
        "specStatus": {
          "enum": ["inventoried", "specified", "homologated"]
        },
        "exceptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "lifecycle": { "const": "proposed" } }
          },
          "then": {
            "properties": {
              "currentLayer": { "type": "null" },
              "sourceFiles": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "currentLayer": { "$ref": "#/$defs/layer" },
              "sourceFiles": { "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
